# ==========================================================
# TaskFlow 环境变量配置模板
# 使用方式：复制本文件为 server/.env，填入真实值后重启后端
# 说明：AI 相关配置为「可选扩展」，不填写也不影响核心任务管理功能
# ==========================================================

# 后端服务端口
PORT=3000

# SQLite 数据文件路径（可选，默认 server/db/task.db）
# DB_PATH=D:/task_manager/server/db/task.db

# ---------- AI 网关配置 ----------
# 支持两种协议，按 Base URL 自动识别；也可用 AI_PROTOCOL 显式指定（anthropic | openai）
#
# 1) Anthropic Messages 协议（Base URL 中含 /anthropic 时自动识别）
#    实际请求：{AI_BASE_URL}/v1/messages，鉴权头 x-api-key
# AI_BASE_URL=https://xxx.cn-beijing.maas.aliyuncs.com/apps/anthropic
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_MODEL=qwen-plus
#
# 2) OpenAI 兼容协议（默认）
#    实际请求：{AI_BASE_URL}/chat/completions，鉴权头 Authorization: Bearer
# AI_BASE_URL=https://your-gateway.example.com/v1
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_MODEL=your-model-name
